# ============================================================
# jblogzy AI 팀 환경변수 설정
# 이 파일을 복사해서 .env 로 이름 변경 후 실제 값 입력
# ============================================================

# Anthropic API (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxx

# 카페24 대시보드 API
CAFE24_API_URL=https://ehe13.mycafe24.com/ai-team/api/report.php
CAFE24_API_KEY=CHANGE_THIS_SECRET_KEY_32CHARS_MIN

# SMTP 이메일 발송
# Brevo:  SMTP_HOST=smtp-relay.brevo.com / SMTP_USER=xxxxx@smtp-brevo.com
# Gmail:  SMTP_HOST=smtp.gmail.com       / SMTP_USER=your@gmail.com
# 카페24: SMTP_HOST=smtp.cafe24.com      / SMTP_USER=your@domain.com
# 다른 사업 적용 시: 아래 4개 값만 교체하면 됨
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-login@smtp-brevo.com
SMTP_PASS=your-smtp-key-or-password
EMAIL_FROM=support@yourdomain.com
EMAIL_FROM_NAME=서비스 이름
